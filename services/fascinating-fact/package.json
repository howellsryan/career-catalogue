{
  "name": "fascinating-fact",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "types": "wrangler types --include-runtime",
    "typecheck": "npm run types && tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "bootstrap": "node scripts/bootstrap.mjs",
    "verify-model": "node scripts/verify-model.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3",
    "wrangler": "4.147.0"
  },
  "dependencies": {
    "htmlparser2": "10.0.0"
  }
}
